enum USER_TYPE {
    FREE
    PREMIUM
}

enum USER_STATE {
    ACTIVE
    NEW
    SETTING_UP
}

model UserData {
    id                  String                @id @default(cuid())
    user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId              String                @unique
    username            String?
    userState           USER_STATE            @default(NEW)
    Vpc                 Vpc[]
    InboundRules        InboundRules[]
    containers          containers[]
    SshKeys             SshKeys[]
    user_type           USER_TYPE             @default(FREE)
    ScheduledContainers ScheduledContainers[]
    incusProjects       IncusProject[]
}

model IncusProject {
    id         String   @id
    name       String?
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
    UserData   UserData @relation(fields: [UserDataId], references: [id])
    UserDataId String
}

model Vpc {
    id         String       @id
    vpcName    String
    cidr       String
    createdAt  DateTime     @default(now())
    updatedAt  DateTime     @updatedAt
    containers containers[]
    UserData   UserData     @relation(fields: [UserDataId], references: [id])
    UserDataId String
}

enum CONTAINER_STATE {
    RUNNING
    STOPPED
}

enum ScheduledContainersStatus {
    PENDING
    SUCCESS
}

model ScheduledContainers {
    id         String                    @id
    UserData   UserData                  @relation(fields: [UserDataId], references: [id], onDelete: Cascade)
    UserDataId String
    SshKeys    SshKeys                   @relation(fields: [SshKeysId], references: [id])
    SshKeysId  String
    name       String
    image      String
    vpc        String
    storage    String
    status     ScheduledContainersStatus @default(PENDING)
}

model containers {
    id           String                 @id
    name         String
    image        String
    state        CONTAINER_STATE
    createdAt    DateTime               @default(now())
    updatedAt    DateTime               @updatedAt
    Vpc          Vpc                    @relation(fields: [vpcId], references: [id], onDelete: Cascade)
    vpcId        String
    ipAddress    String
    InboundRules InboundRules[]
    UserData     UserData               @relation(fields: [UserDataId], references: [id], onDelete: Cascade)
    UserDataId   String
    SshKeys      SshKeys                @relation(fields: [SshKeysId], references: [id])
    SshKeysId    String
    SshPort      SshProxyAvailablePorts @relation(fields: [SshPortId], references: [id])
    SshPortId    String                 @unique
}

model InboundRules {
    id                   String     @id
    domain_name          String     @unique
    service_protocol     String
    container_ip         String
    port                 Int
    createdAt            DateTime   @default(now())
    updatedAt            DateTime   @updatedAt
    UserData             UserData   @relation(fields: [UserDataId], references: [id], onDelete: Cascade)
    UserDataId           String
    containers           containers @relation(fields: [containersName], references: [id], onDelete: Cascade)
    containersName       String
    cloudflare_zone      String
    cloudflare_record_id String
}

model SshProxyAvailablePorts {
    id           String      @id
    sshProxyPort Int
    used         Boolean
    containers   containers?
}

model SshKeys {
    id                  String                @id
    name                String
    publicKey           String
    createdAt           DateTime              @default(now())
    updatedAt           DateTime              @updatedAt
    UserData            UserData              @relation(fields: [UserDataId], references: [id], onDelete: Cascade)
    UserDataId          String
    containers          containers[]
    scheduledContainers ScheduledContainers[]
}
